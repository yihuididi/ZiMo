{
  "name": "@mahjong/api",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "uv run pywrangler deploy --dry-run",
    "test:python": "uv run pytest",
    "test:pyodide": "uv run pywrangler sync && .venv-workers/bin/python -m unittest discover -s tests -p 'test_game_*.py'",
    "test:worker": "vitest run --config vitest.config.mjs"
  },
  "devDependencies": {
    "vitest": "^4.1.0",
    "wrangler": "^4.123.0",
    "ws": "^8.21.0"
  }
}
